{% include "header.liquid" %}
<article>
	<header>
		<h1>{{ page.title }}</h1>
		{% if page.published_date %}
		<p class="meta"><time datetime="{{ page.published_date | date: "%Y-%m-%d" }}">{{ page.published_date | date: "%B %-d, %Y" }}</time></p>
		{% else %}
		<p class="meta">Draft</p>
		{% endif %}
	</header>
	{{ page.content }}
</article>
{% include "footer.liquid" %}
